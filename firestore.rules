rules_version = '2';

// โครงสร้างสิทธิ์: อนุญาตเฉพาะทีมที่มีอีเมลอยู่ใน collection teamMembers เท่านั้น
// เพิ่ม/ลบสมาชิกทีมผ่าน Firebase Console โดยตรง (ห้ามแก้จากฝั่งเว็บ กันคนยกสิทธิ์ตัวเอง)
service cloud.firestore {
  match /databases/{database}/documents {

    function isTeamMember() {
      return request.auth != null &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/teamMembers/$(request.auth.token.email));
    }

    // สินค้า/แบรนด์ — รองรับหลายสินค้าในอนาคต ไม่ผูกกับ MAXIMUS อย่างเดียว
    match /products/{productId} {
      allow read, write: if isTeamMember();
    }

    // แพ็กเกจ/ราคาที่ขายจริงของแต่ละสินค้า (offer ladder)
    match /offers/{offerId} {
      allow read, write: if isTeamMember();
    }

    // ออเดอร์ลูกค้า
    match /orders/{orderId} {
      allow read, write: if isTeamMember();
    }

    // log ค่าแอดรายวัน ใช้คำนวณ CPA จริง
    match /adSpend/{entryId} {
      allow read, write: if isTeamMember();
    }

    // สถานะปฏิทินคอนเทนต์ (โพสต์แล้ว/ยังไม่โพสต์)
    match /contentCalendar/{postId} {
      allow read, write: if isTeamMember();
    }

    // รายชื่อทีมที่มีสิทธิ์เข้าระบบ — เขียนได้เฉพาะผ่าน Firebase Console เท่านั้น
    match /teamMembers/{email} {
      allow read: if isTeamMember();
      allow write: if false;
    }

    // ค่าตั้งค่าหน้า sale page (สี/ฟอนต์/รูป header) — sale page เป็นหน้าสาธารณะไม่มี login
    // จึงต้องอ่านได้โดยไม่ต้อง auth แต่แก้ไขได้เฉพาะทีมเท่านั้น
    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isTeamMember();
    }

    // บทสนทนา Messenger — Cloud Functions (Admin SDK) เขียนข้อความจริงเข้ามา ไม่ผ่าน rules นี้เลย
    // ฝั่งทีมอ่านได้เต็มที่ + แก้ field สถานะระดับบทสนทนาได้ (เช่น mark as read) แต่ห้ามยิงข้อความตรงจาก client
    // การส่งข้อความจริงต้องผ่าน Cloud Function "sendReply" เท่านั้น เพื่อกันไม่ให้ข้อมูลใน Firestore กับสิ่งที่ลูกค้าได้รับจริงไม่ตรงกัน
    match /conversations/{psid} {
      allow read: if isTeamMember();
      allow update: if isTeamMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]);
      allow create, delete: if false;

      match /messages/{messageId} {
        allow read: if isTeamMember();
        allow write: if false;
      }
    }
  }
}
